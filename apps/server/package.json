{
  "name": "@clipsync/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ClipSync 云端服务（NestJS + Prisma + Better Auth）",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@clipsync/shared": "workspace:*",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/platform-socket.io": "^12.5.0",
    "@nestjs/websockets": "^12.5.0",
    "@prisma/client": "^6.19.3",
    "better-auth": "^1.7.23",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "prisma": "^6.19.3",
    "typescript": "^6.0.3"
  }
}
