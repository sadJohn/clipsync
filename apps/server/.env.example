# 云端 PostgreSQL 连接串（替换为你的云数据库地址，例如 Neon / Supabase / 阿里云 RDS）
# 示例：postgresql://user:password@host:5432/clipsync?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/clipsync?sslmode=require"

# Better Auth 签名密钥（用于加密 Session / Token），请填入足够长的随机字符串
BETTER_AUTH_SECRET=""

# 云端服务对外地址（部署后改为真实域名）
BETTER_AUTH_URL="http://localhost:3000"

PORT=3000

# 允许的跨域来源，逗号分隔；Electron 开发环境为 http://localhost:5173
TRUSTED_ORIGINS="http://localhost:5173"

# 邮件服务（用于发送改邮箱 / 重置密码验证码）
# 二选一，配置了 RESEND_API_KEY 时优先走 Resend，否则走 SMTP
# 两者都未配置时仅开发环境可用：验证码会打印到服务端日志，生产环境会直接报错

# 方式一：Resend
RESEND_API_KEY=""
# 测试模式可先用 onboarding@resend.dev；只允许发到 Resend 账号绑定邮箱
# 生产环境请换成已验证域名下的地址，例如 ClipSync <no-reply@mail.example.com>
EMAIL_FROM="ClipSync <onboarding@resend.dev>"

# 方式二：SMTP（Gmail / QQ 邮箱 / 自建邮件服务等），EMAIL_FROM 填发件邮箱
# SMTP_PORT=465 时自动使用 SSL
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
