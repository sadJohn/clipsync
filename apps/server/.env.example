# 云端 PostgreSQL 连接串（替换为你的云数据库地址，例如 Neon / Supabase / 阿里云 RDS）
# 示例：postgresql://user:password@host:5432/clipsync?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/clipsync?sslmode=require"

# Better Auth 签名密钥（用于加密 Session / Token），请填入足够长的随机字符串
BETTER_AUTH_SECRET=""

# 云端服务对外地址（部署后改为真实域名）
BETTER_AUTH_URL="http://localhost:3000"

PORT=3000

# 允许的跨域来源，逗号分隔；Electron 开发环境为 http://localhost:5173
TRUSTED_ORIGINS="http://localhost:5173"
