    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.3.2",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
