{
  "name": "@clipsync/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "ClipSync 桌面客户端（Electron + React + better-sqlite3）",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
