    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.73.0",
    "sonner": "^2.0.8",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
